#!/bin/sh /etc/rc.common
# Ruijie 802.1X EAP-MD5 认证客户端 procd init 脚本
# 配置:/etc/config/ruijie

USE_PROCD=1
START=90
STOP=10

PROG=/usr/sbin/ruijie_auth
PASS_FILE=/var/run/ruijie-auth.pass
STATUS_FILE=/var/run/ruijie-auth.status

start_service() {
	local enabled interface username password auth_servers mac
	local timeout retry_delay start_burst debug

	config_load ruijie
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get interface main interface
	config_get username main username
	config_get password main password
	config_get auth_servers main auth_servers
	config_get mac main mac
	config_get timeout main timeout 3
	config_get retry_delay main retry_delay 3
	config_get start_burst main start_burst 2
	config_get_bool debug main debug 0

	[ -n "$interface" ] && [ -n "$username" ] && [ -n "$password" ] || {
		logger -t ruijie-auth "missing interface/username/password in /etc/config/ruijie"
		return 0
	}

	# 空值回退默认,防止守护进程因空参数拒绝启动
	[ -n "$auth_servers" ] || auth_servers='202.199.30.31;202.199.29.94'
	[ -n "$timeout" ] || timeout=3
	[ -n "$retry_delay" ] || retry_delay=3
	[ -n "$start_burst" ] || start_burst=2

	# 密码写入仅 root 可读的临时文件,避免出现在 ps 输出
	umask 077
	printf '%s\n' "$password" > "$PASS_FILE" || return 0

	procd_open_instance
	procd_set_param command "$PROG" \
		--interface "$interface" \
		--username "$username" \
		--password-file "$PASS_FILE" \
		--auth-servers "$auth_servers" \
		--timeout "$timeout" \
		--retry-delay "$retry_delay" \
		--start-burst "$start_burst" \
		--success-file "$STATUS_FILE"
	[ -n "$mac" ] && procd_append_param command --mac "$mac"
	[ "$debug" -eq 1 ] && procd_append_param command --debug
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	procd_kill
	rm -f "$PASS_FILE" "$STATUS_FILE"
}

service_triggers() {
	procd_add_reload_trigger ruijie
}

reload_service() {
	stop
	start
}
